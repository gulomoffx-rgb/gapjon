# Copy this file to .env and fill it in. Never share .env with anyone.

# From @BotFather after /newbot. Anyone with this token controls the bot.
BOT_TOKEN=

# Your HTTPS address where this server is reachable, e.g. https://app.gapjon.uz
WEBAPP_URL=

# The short name you chose in @BotFather /newapp (used for invite links), e.g. app
APP_SHORT_NAME=app

# Your Telegram user ID (ask @userinfobot). Several IDs: 111,222
ADMIN_IDS=

PORT=8080
# DB_FILE=data/gapjon.db

# DEV=1 lets anyone log in without Telegram. Only for testing on your own computer.
DEV=0
